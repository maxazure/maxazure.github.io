---
import Base from '../../layouts/Base.astro';
import ProjectIndex from '../../components/ProjectIndex.astro';
import { localeCodes, type Locale } from '../../lib/locales';
export function getStaticPaths() {
  return localeCodes.filter(locale => locale !== 'en').map(locale => ({ params: { locale }, props: { locale } }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<Base locale={locale} kind="projects"><ProjectIndex locale={locale} /></Base>
