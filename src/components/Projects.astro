---
import { projects } from '../data/projects';
import type { Locale } from '../data/profile';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const cases = projects[locale];
const statuses = en
  ? { live: 'Website', private: 'Private system', development: 'Development instance', prototype: 'Prototype', open: 'Open source', holding: 'Historical project', archive: 'Archived project', mvp: 'MVP · preparing for pilots', operational: 'Internal operational system' }
  : { live: '网站项目', private: '非开源系统', development: '开发实例', prototype: '实验原型', open: '开源项目', holding: '历史项目', archive: '归档项目', mvp: 'MVP · 准备试点', operational: '内部使用系统' };
---
<section class="work-section section-space" id="portfolio" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-header"><div><p class="eyebrow">{en ? 'Complete project collection' : '完整项目集'}</p><h2 id="work-title" class="display-heading">{en ? 'A wider view of the work.' : '更多项目与实践。'}</h2></div><p class="project-count"><strong>{cases.length}</strong><span>{en ? 'project examples' : '个项目案例'}</span></p></div>
    <p class="section-description">{en ? 'AI systems, voice workflows, enterprise software and web applications. Client work is anonymised; previews include screenshots and illustrative interfaces.' : 'AI 系统、语音工作流、企业软件与 Web 应用。客户案例匿名处理，预览包括截图与界面示意。'}</p>
    <div class="project-gallery">{cases.map((project, index) => <article class="project-card" data-project={project.id} id={`project-${project.id}`}>
      {cases.findIndex(item => item.group === project.group) === index && <span id={`projects-${project.group}`} class="group-anchor" aria-hidden="true"></span>}
      <figure class="case-preview"><div class="preview-frame"><img src={project.image} alt={project.alt} width="320" height="200" loading="lazy" decoding="async" draggable="false" />{project.image.endsWith('-interface.jpg') && <span class="media-label">{en ? 'AI interface illustration' : 'AI 界面示意'}</span>}</div></figure>
      <div class="case-copy"><p class="case-meta"><span class="case-index">{String(index + 1).padStart(2, '0')}</span><span class="case-status">{statuses[project.status]}</span></p><h3>{project.name}</h3><p>{project.description}</p></div>
      {'href' in project && <div class="case-action"><a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.status === 'open' ? 'GitHub' : project.status === 'holding' ? (en ? 'Current site' : '访问现网站') : project.status === 'mvp' ? (en ? 'Demo & team' : '演示与团队') : (en ? 'Visit website' : '访问网站')}<Arrow /></a></div>}
    </article>)}</div>
  </div>
</section>
