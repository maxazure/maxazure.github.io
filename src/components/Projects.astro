---
import { ui } from '../data/content';
import { projects } from '../data/projects';
import type { Locale } from '../data/profile';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const cases = projects[locale];
const statuses: Record<string, Parameters<typeof t>[0]> = { live: 'Website', private: 'Private system', development: 'Development instance', prototype: 'Prototype', open: 'Open source', holding: 'Historical project', archive: 'Archived project', mvp: 'MVP · preparing for pilots', operational: 'Internal operational system' };
---
<section class="work-section section-space" id="portfolio" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-header"><div><p class="eyebrow">{t("Complete project collection")}</p><h2 id="work-title" class="display-heading">{t("A wider view of the work.")}</h2></div><p class="project-count"><strong>{cases.length}</strong><span>{t("project examples")}</span></p></div>
    <p class="section-description">{t("AI systems, voice workflows, enterprise software and web applications. Client work is anonymised; previews include screenshots and illustrative interfaces.")}</p>
    <div class="project-gallery">{cases.map((project, index) => <article class="project-card" data-project={project.id} id={`project-${project.id}`}>
      {cases.findIndex(item => item.group === project.group) === index && <span id={`projects-${project.group}`} class="group-anchor" aria-hidden="true"></span>}
      <figure class="case-preview"><div class="preview-frame"><img src={project.image} alt={project.alt} width="320" height="200" loading="lazy" decoding="async" draggable="false" />{project.image.endsWith('-interface.jpg') && <span class="media-label">{t("AI interface illustration")}</span>}</div></figure>
      <div class="case-copy"><p class="case-meta"><span class="case-index">{String(index + 1).padStart(2, '0')}</span><span class="case-status">{t(statuses[project.status])}</span></p><h3>{project.name}</h3><p>{project.description}</p></div>
      {'href' in project && <div class="case-action"><a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.status === 'open' ? 'GitHub' : project.status === 'holding' ? (t("Current site")) : project.status === 'mvp' ? (t("Demo & team")) : (t("Visit website"))}<Arrow /></a></div>}
    </article>)}</div>
  </div>
</section>
