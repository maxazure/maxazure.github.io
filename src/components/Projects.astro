---
import { projects } from '../data/projects';
import type { Locale } from '../data/profile';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
const groups = [
  { id: 'labs', label: en ? 'Systems, tools & experiments' : '个人系统、开源工具与实验', description: en ? 'Working interfaces, source code and the engineering behind them.' : '实际系统界面、公开代码及实现思路。' },
  { id: 'recent', label: en ? 'Recent client work' : '近期客户案例', description: en ? 'Websites organised around real service and content needs.' : '围绕实际服务与内容需求交付的网站。' },
  { id: 'legacy', label: en ? 'Earlier projects' : '早期项目', description: en ? 'Selected work from my earlier web and application development.' : '早期 Web 与应用开发中的部分案例。' },
];
const statuses = en ? {live:'Live website',private:'Private system',prototype:'Prototype',open:'Open source',holding:'Historical project',archive:'Archived project'} : {live:'已上线网站',private:'非开源系统',prototype:'实验原型',open:'开源项目',holding:'历史项目',archive:'归档项目'};
---
<section class="work-section section-space" id="portfolio" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-header"><div><p class="eyebrow">{en ? 'Selected projects' : '项目案例'}</p><h2 id="work-title" class="display-heading">{en ? 'See what I build.' : '看做出来的项目。'}</h2></div><p class="work-evidence-note">{en ? 'Client identities are omitted. Screenshots are small, redacted previews.' : '客户案例按行业匿名展示。截图已做隐私处理，仅供概览。'}</p></div>
    <p class="section-description">{en ? 'Websites, software systems and tools, with a practical use case and the engineering behind each one.' : '从行业网站到软件系统与工具，展示实际用途和具体实现。'}</p>
    <nav class="project-jump-nav" aria-label={en ? 'Project groups' : '项目分组'}>{groups.map(group => <a href={`#projects-${group.id}`}>{group.label}<Arrow direction="right" /></a>)}</nav>
    {groups.map((group, index) => <section class="case-group" id={`projects-${group.id}`} aria-labelledby={`projects-${group.id}-title`}>
      <div class="case-group-heading"><span class="case-group-index" aria-hidden="true">0{index + 1}</span><div><h3 id={`projects-${group.id}-title`}>{group.label}</h3><p>{group.description}</p></div></div>
      <div class="case-list">{projects[locale].filter(project => project.group === group.id).map(project => <article class:list={['case-row', !('image' in project) && 'case-row-code']} data-project={project.id}>
        {'image' in project ? <figure class="case-preview"><img src={project.image} alt={project.alt} width="320" height="200" loading="lazy" decoding="async" draggable="false" /><figcaption>{project.caption}</figcaption></figure> : <div class="code-preview" aria-hidden="true"><span>&lt;/&gt;</span><p>{en ? 'Open-source tooling' : '开源工具'}</p></div>}
        <div class="case-copy"><p class="case-status">{statuses[project.status]}</p><h4>{project.name}</h4><p>{project.description}</p><ul class="tags" aria-label={en ? 'Technology and methods' : '技术与方法'}>{project.tags.map(tag => <li>{tag}</li>)}</ul></div>
        <div class="case-action">{'href' in project ? <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.status === 'open' ? 'GitHub' : project.status === 'holding' ? (en ? 'Current site' : '访问现网站') : (en ? 'Visit website' : '访问网站')}<Arrow /></a> : <span>{project.status === 'archive' ? (en ? 'Historical preview' : '历史界面') : (en ? 'Interface preview' : '界面概览')}</span>}</div>
      </article>)}</div>
    </section>)}
  </div>
</section>
