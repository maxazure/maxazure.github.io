---
import { ui } from '../data/content';
import { localePath } from '../lib/locales';
import { copy, profile, type Locale } from '../data/profile';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Projects from './Projects.astro';
import CrmDemo from './CrmDemo.astro';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const root = localePath(locale);
---
<Header locale={locale} kind="projects" />
<main id="main">
  <div class="project-index-intro shell">
    <a class="text-link" href={root}>{copy[locale].backHome}<Arrow /></a>
    <h1>{t("Projects & engineering work.")}</h1>
    <p>{t("Enterprise systems, applied AI, developer tools and earlier work. For the business context, my role and engineering decisions, start with the four selected cases.")}</p>
    <a class="text-link" href={`${root}#portfolio`}>{t("Read the selected engineering cases")}<Arrow direction="right" /></a>
  </div>
  <CrmDemo locale={locale} />
  <Projects locale={locale} />
  <div class="project-index-contact shell"><a class="text-link" href={`${root}#contact`}>{t("Discuss a role with Jay")}<Arrow /></a><a class="text-link" href={profile.cvUrl}>{copy[locale].cvLabel}<Arrow /></a></div>
</main>
<Footer locale={locale} />
