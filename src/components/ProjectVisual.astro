---
interface Props { kind: 'flow' | 'orbit'; locale: 'en' | 'zh' }
const { kind, locale } = Astro.props;
const labels = locale === 'en' ? ['Plan', 'Execute', 'Verify'] : ['规划', '执行', '验证'];
---
<div class:list={['project-visual', `visual-${kind}`]} aria-hidden="true">
  {kind === 'flow' ? <>
    <div class="flow-grid"></div>
    <svg class="flow-lines" viewBox="0 0 600 260" fill="none"><path d="M30 130h125c35 0 35-58 70-58h75c35 0 35 116 70 116h85c35 0 35-58 70-58h55" /><path d="M30 130h125c35 0 35 58 70 58h75c35 0 35-116 70-116h85c35 0 35 58 70 58h55" /></svg>
    <div class="flow-nodes">{labels.map((label, i) => <span class:list={['flow-node', i === 1 && 'flow-node-main']}>{label}</span>)}</div>
    <span class="visual-caption">{locale === 'en' ? 'Plan → execute → validate' : '规划 → 执行 → 验证'}</span>
  </> : <>
    <div class="orbit-drawing"><i class="tool-orbit tool-orbit-one"></i><i class="tool-orbit tool-orbit-two"></i><i class="tool-orbit tool-orbit-three"></i><span class="tool-core">K</span><span class="tool-dot tool-dot-one"></span><span class="tool-dot tool-dot-two"></span><span class="tool-dot tool-dot-three"></span></div>
    <span class="visual-caption">{locale === 'en' ? 'Source → retrieve → verify' : '来源 → 检索 → 检查'}</span>
  </>}
</div>
