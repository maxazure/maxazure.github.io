---
import { copy, type Locale } from '../data/profile';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
---
<Header locale={locale} kind="privacy" />
<main id="main" class="shell document-page">
  <a class="text-link" href={locale === 'en' ? '/' : '/zh/'}>{c.backHome}<Arrow direction="right" /></a>
  <p class="eyebrow">{c.privacy}</p>
  <h1>{c.privacyHeading.split('\n').map((line) => <span>{line}</span>)}</h1>
  <p class="lead">{c.privacyIntro}</p>
  <p class="document-date"><time datetime="2026-10-10">{c.updatedLabel}</time></p>
  {c.privacySections.map(([title, body]) => <section><h2>{title}</h2><p>{body}</p></section>)}
  <a class="text-link" href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener noreferrer">GitHub Privacy Statement<Arrow /></a>
</main>
<Footer locale={locale} />
