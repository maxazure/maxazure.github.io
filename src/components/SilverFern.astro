---
// Static renders carry the same sculptural fern when JavaScript or WebGL is absent.
---
<div class="hero-fern" aria-hidden="true">
  <picture>
    <source media="(max-width: 799px)" srcset="/brand/silver-fern-mobile-v3.webp" />
    <img src="/brand/silver-fern-desktop-v3.webp" width="593" height="530" alt="" decoding="async" fetchpriority="high" draggable="false" />
  </picture>
  <canvas class="fern-canvas"></canvas>
</div>
<script>
  import type { FernFrame } from '../lib/fern-renderer';
  const stage = document.querySelector<HTMLElement>('.hero-fern');
  const canvas = stage?.querySelector<HTMLCanvasElement>('canvas');
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = matchMedia('(min-width: 800px) and (hover: hover) and (pointer: fine)');
  const dataSaver = (navigator as Navigator & { connection?: { saveData: boolean } }).connection?.saveData;
  if (stage && canvas && desktop.matches && !motion.matches && !dataSaver && 'transferControlToOffscreen' in canvas && 'Worker' in window) {
    const initialise = () => {
      let worker: Worker;
      let offscreen: OffscreenCanvas;
      try {
        worker = new Worker(new URL('../lib/fern-renderer.ts', import.meta.url), { type: 'module' });
        offscreen = canvas.transferControlToOffscreen();
      } catch { return; }
      let pointerX = 0, pointerY = 0, frame = 0, available = true;
      const update = (): FernFrame => {
        const scale = Math.min(devicePixelRatio, 1.5);
        return { width: Math.round(stage.clientWidth * scale), height: Math.round(stage.clientHeight * scale), pointerX, pointerY };
      };
      const render = () => {
        frame = 0;
        if (!available || motion.matches || !desktop.matches) { stage.dataset.rendered = 'false'; return; }
        const size = update();
        if (size.width && size.height) worker.postMessage(size);
      };
      const schedule = () => { if (!frame && available) frame = requestAnimationFrame(render); };
      const observer = new ResizeObserver(schedule);
      const fallback = () => {
        available = false; stage.dataset.rendered = 'false';
        observer.disconnect(); worker.terminate();
      };
      worker.addEventListener('message', ({ data }) => {
        if (!data.rendered) { fallback(); return; }
        stage.dataset.rendered = desktop.matches && !motion.matches ? 'true' : 'false';
        stage.dataset.frame = String(data.frame);
      });
      worker.addEventListener('error', fallback);
      observer.observe(stage);
      stage.addEventListener('pointermove', event => {
        if (!desktop.matches || motion.matches) return;
        const bounds = stage.getBoundingClientRect();
        pointerX = (event.clientX - bounds.left) / bounds.width - .5;
        pointerY = (event.clientY - bounds.top) / bounds.height - .5;
        schedule();
      }, { passive: true });
      stage.addEventListener('pointerleave', () => { pointerX = pointerY = 0; schedule(); });
      motion.addEventListener('change', schedule);
      desktop.addEventListener('change', schedule);
      worker.postMessage({ ...update(), canvas: offscreen }, [offscreen]);
    };
    if ('requestIdleCallback' in window) window.requestIdleCallback(initialise, { timeout: 1500 });
    else setTimeout(initialise, 0);
  }
</script>
