---
import { copy, type Locale } from '../data/profile';
import { ui } from '../data/content';
import { locales, localeCodes, localePath, type PageKind } from '../lib/locales';
interface Props { locale: Locale; kind?: PageKind }
const { locale, kind = 'home' } = Astro.props;
const c = copy[locale];
const t = ui(locale);
const root = localePath(locale);
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={root} aria-label={t('Jay Liu home')}>JAY LIU<span aria-hidden="true">.</span></a>
    <nav class="desktop-nav" aria-label={c.navLabel}>
      {c.nav.map(([id, label]) => <a href={`${kind === 'home' ? '' : root}#${id}`}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <details class="language-switch">
        <summary aria-label={t('Languages')} title={t('Languages')} aria-controls="language-options">
          <svg class="translation-icon" viewBox="0 0 28 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 2h14v15H2zM16 7h10v15H12v-5"/><path d="m5 13 4-8 4 8M6.5 10h5"/><circle cx="20" cy="14.5" r="3.5"/><path d="M16.5 14.5h7M20 11c-2 2-2 5 0 7m0-7c2 2 2 5 0 7"/></svg>
          <svg class="language-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>
        </summary>
        <nav id="language-options" class="language-options" aria-label={t('Languages')}>
          <ul>{localeCodes.map(code => <li><a href={localePath(code, kind)} hreflang={locales[code].lang} aria-current={code === locale && kind !== '404' ? 'page' : undefined} data-language={code}><span>{t(locales[code].name)}</span>{code === locale && <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 8 3 3 7-7"/></svg>}</a></li>)}</ul>
        </nav>
      </details>
      <button class="menu-button" aria-controls="mobile-nav" aria-expanded="false" type="button">
        <span>{c.menu}</span><span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav shell" aria-label={c.navLabel}>
    {c.nav.map(([id, label]) => <a href={`${kind === 'home' ? '' : root}#${id}`}>{label}</a>)}
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('#mobile-nav');
  const languages = document.querySelector<HTMLDetailsElement>('.language-switch');
  const languageToggle = languages?.querySelector('summary');
  if (header && button && nav && languages && languageToggle) {
    header.classList.add('enhanced');
    const closeNav = () => { button.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); };
    const closeLanguages = () => { languages.open = false; };
    const syncFragment = () => { languages.querySelectorAll<HTMLAnchorElement>('a').forEach(link => { link.hash = window.location.hash; }); };
    syncFragment();
    window.addEventListener('hashchange', syncFragment);
    languages.addEventListener('toggle', () => { if (languages.open) closeNav(); });
    languages.addEventListener('focusout', (event) => { if (event.relatedTarget && !languages.contains(event.relatedTarget as Node)) closeLanguages(); });
    languages.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) closeLanguages(); });
    button.addEventListener('click', () => {
      closeLanguages();
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    });
    nav.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a');
      if (!link) return;
      closeNav();
      const fragment = new URL(link.href).hash;
      const section = fragment && document.getElementById(fragment.slice(1));
      if (section) { section.setAttribute('tabindex', '-1'); section.focus({ preventScroll: true }); }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (languages.open) { closeLanguages(); languageToggle.focus(); }
      else if (button.getAttribute('aria-expanded') === 'true') { closeNav(); button.focus(); }
    });
    document.addEventListener('click', (event) => {
      if (!languages.contains(event.target as Node)) closeLanguages();
      if (!header.contains(event.target as Node)) closeNav();
    });
    window.matchMedia('(min-width: 800px)').addEventListener('change', () => {
      if (nav.contains(document.activeElement)) header.querySelector<HTMLAnchorElement>('.wordmark')?.focus();
      closeNav();
      if (languages.contains(document.activeElement)) languageToggle.focus();
      closeLanguages();
    });
  }
</script>
