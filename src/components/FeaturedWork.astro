---
import { content, ui } from '../data/content';
import { localePath } from '../lib/locales';
import { featuredWork } from '../data/featured-work';
import type { Locale } from '../data/profile';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const archive = localePath(locale, 'projects');
---
<section class="work-section section-space" id="portfolio" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-header">
      <div><p class="eyebrow">{t("Selected engineering work")}</p><h2 id="work-title" class="display-heading">{t("From business problems to working systems.")}</h2></div>
    </div>
    <p class="section-description">{t("Four examples of how I approach business software and applied AI, with my role and the available evidence made explicit.")}</p>
    <div class="featured-list">{featuredWork(locale).map((project) => <article class="featured-case" data-featured={project.id}>
      <div class="featured-heading">
        <p class="case-category">{project.category}</p>
        <h3>{project.name}</h3>
        <p class="featured-stage">{project.stage}</p>
        <ul class="case-technologies" aria-label={t("Technologies and focus")}>{project.tags.map(tag => <li>{tag}</li>)}</ul>
        {'href' in project && 'linkLabel' in project && <a class="text-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.linkLabel}<Arrow /></a>}
        {!('href' in project) && <a class="text-link" href={`${archive}#crm-demo`}>{content[locale].crmDemo.link}<Arrow /></a>}
      </div>
      <div class="featured-body">
        <p class="case-problem">{project.problem}</p>
        <dl class="case-reasoning">
          <div><dt>{t("My role")}</dt><dd>{project.role}</dd></div>
          <div><dt>{t("Constraint & decision")}</dt><dd>{project.decision}</dd></div>
          <div><dt>{t("Current evidence")}</dt><dd>{project.evidence}</dd></div>
        </dl>
      </div>
    </article>)}</div>
    <div class="work-archive-link"><p>{t("More enterprise systems, AI tools, voice workflows and earlier projects.")}</p><a class="text-link" href={archive}>{t("Explore all 30 projects")}<Arrow direction="right" /></a></div>
    <nav class="project-group-links" aria-label={t("More project categories")}>
      <a id="projects-enterprise" href={`${archive}#projects-enterprise`}>{t("Enterprise systems")}</a>
      <a id="projects-labs" href={`${archive}#projects-labs`}>{t("AI & engineering tools")}</a>
      <a id="projects-recent" href={`${archive}#projects-recent`}>{t("Web applications")}</a>
      <a id="projects-legacy" href={`${archive}#projects-legacy`}>{t("Earlier work")}</a>
    </nav>
  </div>
</section>
