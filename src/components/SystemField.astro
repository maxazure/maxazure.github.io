// A mathematical illustration, unrelated to any employer or client system.
const project = (x: number, y: number, z: number) => {
  const a = -0.36, b = 0.48;
  const xx = x * Math.cos(b) + z * Math.sin(b);
  const zz = -x * Math.sin(b) + z * Math.cos(b);
  const yy = y * Math.cos(a) - zz * Math.sin(a);
  return [300 + xx * 208, 290 + yy * 208];
};
const path = (points: number[][]) => points.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' ');
const latitude = Array.from({ length: 17 }, (_, i) => {
  const t = -Math.PI / 2 + (i + 1) * Math.PI / 18;
  return path(Array.from({ length: 81 }, (_, j) => {
    const u = j * Math.PI * 2 / 80;
    return project(Math.cos(t) * Math.cos(u), Math.sin(t), Math.cos(t) * Math.sin(u));
  }));
});
const longitude = Array.from({ length: 24 }, (_, i) => path(Array.from({ length: 61 }, (_, j) => {
  const t = j * Math.PI / 60, u = i * Math.PI * 2 / 24;
  return project(Math.sin(t) * Math.cos(u), Math.cos(t), Math.sin(t) * Math.sin(u));
})));
---
<svg class="system-field" viewBox="0 0 600 580" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="sphere-light"><stop offset="0" stop-color="#292f2c" /><stop offset="1" stop-color="#121413" stop-opacity="0" /></radialGradient>
    <linearGradient id="wire-light" x1="100" y1="140" x2="450" y2="470" gradientUnits="userSpaceOnUse"><stop stop-color="#66716b" /><stop offset="1" stop-color="#2e3631" /></linearGradient>
    <pattern id="field-grid" width="32" height="32" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".7" fill="#556057" opacity=".45" /></pattern>
  </defs>
  <path fill="url(#field-grid)" d="M0 0h600v580H0z" />
  <circle cx="300" cy="290" r="244" fill="url(#sphere-light)" />
  <path d="M20 290h560M300 20v540" stroke="#39423c" stroke-dasharray="3 7" stroke-width=".7" />
  <g stroke="url(#wire-light)" stroke-width=".85">
    {latitude.map((d) => <path d={d} />)}
    {longitude.map((d) => <path d={d} />)}
  </g>
  <ellipse class="accent-orbit" cx="300" cy="290" rx="275" ry="102" transform="rotate(-32 300 290)" stroke="#ff835b" stroke-width="1.3" />
  <ellipse cx="300" cy="290" rx="260" ry="75" transform="rotate(48 300 290)" stroke="#9aa69e" stroke-width=".8" stroke-dasharray="4 9" opacity=".55" />
  <g fill="#ff835b"><circle cx="79" cy="429" r="6" /><circle cx="521" cy="151" r="5" /></g>
  <g stroke="#ff835b" opacity=".5"><circle cx="79" cy="429" r="12" /><circle cx="521" cy="151" r="11" /></g>
  <circle cx="300" cy="290" r="3" fill="#e7ebe5" />
  <path d="M34 46V28h18m496 0h18v18M34 534v18h18m496 0h18v-18" stroke="#728078" />
</svg>
