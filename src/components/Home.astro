---
import { copy, profile, type Locale } from '../data/profile';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Arrow from './Arrow.astro';
import Projects from './Projects.astro';
import TransformerField from './TransformerField.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
---
<Header locale={locale} />
<main id="main">
  <div class="hero-backdrop">
  <section class="hero shell" id="home" aria-labelledby="hero-title">
    <div class="hero-main">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{c.location}</p>
      <h1 id="hero-title"><span class="hero-name">Jay Liu<span class="name-stop">.</span></span><span class="hero-role">{c.role}</span></h1>
      <p class="hero-intro">{c.heroIntro}</p>
      <p class="hero-description">{c.heroBody}</p>
      <div class="hero-actions"><a class="button button-primary" href="#resume">{c.viewExperience}<Arrow direction="right" /></a><a class="text-link" href="#portfolio">{c.viewWork}<Arrow /></a></div>
    </div>
    <aside class="hero-panel" aria-label={locale === 'en' ? 'Engineering focus' : '技术主攻方向'}>
      <p class="panel-head"><span>{locale === 'en' ? 'Engineering focus' : '主攻方向'}</span><span>03</span></p>
      <TransformerField />
      <ol class="domain-list">{c.heroDomains.map((domain, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{domain}</li>)}</ol>
    </aside>
  </section>
  </div>
  <div class="stack-strip"><div class="shell stack-inner"><span>ERP / CRM</span><span>.NET</span><span>React</span><span>Python</span><span>AI Agents</span><span>{locale === 'en' ? 'From architecture to delivery' : '从架构设计到系统交付'}<span class="small-cross" aria-hidden="true">+</span></span></div></div>

  <section class="about-section shell section-space" id="about" aria-labelledby="about-title">
    <div class="section-intro"><p class="eyebrow">{c.aboutLabel}</p><h2 id="about-title" class="display-heading">{c.aboutHeading.split('\n').map((line) => <span>{line}</span>)}</h2></div>
    <div class="about-copy"><p class="lead">{c.aboutLead}</p><p>{c.aboutBody}</p><p>{c.aboutBody2}</p></div>
  </section>

  <section class="skills-section shell section-space" id="skills" aria-labelledby="skills-title">
    <div class="section-header"><div><p class="eyebrow">{c.skillLabel}</p><h2 id="skills-title" class="display-heading">{c.skillHeading.split('\n').map((line) => <span>{line}</span>)}</h2></div></div>
    <p class="section-description">{c.skillIntro}</p>
    <div class="skills-grid">{c.skills.map((skill) => <article class="skill-group"><h3>{skill.name}</h3><p>{skill.summary}</p><ul>{skill.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
  </section>

  <section class="experience-section section-space" id="resume" aria-labelledby="experience-title"><div class="shell experience-layout">
    <div class="experience-intro"><p class="eyebrow">{c.experienceLabel}</p><h2 id="experience-title" class="display-heading">{c.experienceHeading}</h2><p>{c.experienceIntro}</p><div class="education"><p class="eyebrow">{c.educationLabel}</p><h3>{c.education}</h3><p>{c.educationSchool}</p><p>{c.educationNote}</p></div></div>
    <ol class="experience-list">{c.experience.map((item, i) => <li class:list={['experience-row', i === 0 && 'current-role']}><p class="experience-date">{item.date}</p><div><h3>{item.role}</h3><p class="experience-company">{item.company}</p><p class="experience-place">{item.place}</p><p class="experience-description">{item.description}</p></div></li>)}</ol>
  </div></section>

  <Projects locale={locale} />

  <section class="contact-section shell section-space" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">{c.contactLabel}</p><div class="contact-layout"><div><h2 id="contact-title">{c.contactHeading}</h2><p>{c.contactBody}</p><a class="contact-email" href={`mailto:${profile.email}`} aria-label={`${c.emailLabel}: ${profile.email}`}>{profile.email}<Arrow /></a></div><div class="contact-side"><p>{c.location}</p><nav aria-label={locale === 'en' ? 'Jay’s profiles' : 'Jay 的个人主页'}>{profile.social.map((item) => <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">{item.label}<Arrow /></a>)}</nav></div></div>
  </section>
</main>
<Footer locale={locale} />
