---
import { copy, profile, type Locale } from '../data/profile';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Arrow from './Arrow.astro';
import SystemField from './SystemField.astro';
import Projects from './Projects.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
---
<Header locale={locale} />
<main id="main">
  <section class="hero shell" id="home" aria-labelledby="hero-title">
    <div class="hero-main">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{c.heroLabel}</p>
      <h1 id="hero-title">Jay Liu<span class="name-stop">.</span><span class="hero-role">{c.role}</span></h1>
      <p class="hero-intro">{c.heroIntro}</p>
      <p class="hero-description">{c.heroBody}</p>
      <div class="hero-actions"><a class="button button-primary" href="#portfolio">{c.viewWork}<Arrow direction="right" /></a><a class="text-link" href="#contact">{c.getInTouch}<Arrow /></a></div>
      <div class="hero-current"><span class="status-dot" aria-hidden="true"></span><span>{c.current}</span><span class="current-divider" aria-hidden="true">/</span><span>{c.location}</span></div>
    </div>
    <div class="hero-art"><span class="art-label">{c.orbitLabel}</span><SystemField /><p class="art-footer">{c.orbitFooter}</p></div>
  </section>
  <div class="stack-strip"><div class="shell stack-inner"><span>FinTech</span><span>.NET</span><span>React</span><span>Cloud</span><span>AI agents</span><span>{locale === 'en' ? 'Built with curiosity' : '持续探索与实践'}<span class="small-cross" aria-hidden="true">+</span></span></div></div>

  <Projects locale={locale} />

  <section class="about-section shell section-space" id="about" aria-labelledby="about-title">
    <div class="section-intro"><p class="eyebrow">{c.aboutLabel}</p><h2 id="about-title" class="display-heading">{c.aboutHeading.split('\n').map((line) => <span>{line}</span>)}</h2></div>
    <div class="about-copy"><p class="lead">{c.aboutLead}</p><p>{c.aboutBody}</p><p>{c.aboutBody2}</p><dl class="about-facts">{c.aboutFacts.map(([value, label]) => <div><dt>{value}</dt><dd>{label}</dd></div>)}</dl></div>
  </section>

  <section class="skills-section shell section-space" id="skills" aria-labelledby="skills-title">
    <div class="section-header"><div><p class="eyebrow">{c.skillLabel}</p><h2 id="skills-title" class="display-heading">{c.skillHeading.split('\n').map((line) => <span>{line}</span>)}</h2></div></div>
    <p class="section-description">{c.skillIntro}</p>
    <div class="skills-grid">{c.skills.map((skill) => <article class="skill-group"><h3>{skill.name}</h3><p>{skill.summary}</p><ul>{skill.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
  </section>

  <section class="experience-section section-space" id="resume" aria-labelledby="experience-title"><div class="shell experience-layout">
    <div class="experience-intro"><p class="eyebrow">{c.experienceLabel}</p><h2 id="experience-title" class="display-heading">{c.experienceHeading}</h2><p>{c.experienceIntro}</p><div class="education"><p class="eyebrow">{c.educationLabel}</p><h3>{c.education}</h3><p>{c.educationSchool}</p><p>{c.educationNote}</p></div></div>
    <ol class="experience-list">{c.experience.map((item, i) => <li class:list={['experience-row', i === 0 && 'current-role']}><p class="experience-date">{item.date}</p><div><h3>{item.role}</h3><p class="experience-company">{item.company}</p><p class="experience-place">{item.place}</p><p class="experience-description">{item.description}</p></div></li>)}</ol>
  </div></section>

  <section class="contact-section shell section-space" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">{c.contactLabel}</p><div class="contact-layout"><div><h2 id="contact-title">{c.contactHeading}</h2><p>{c.contactBody}</p><a class="contact-email" href={`mailto:${profile.email}`} aria-label={`${c.emailLabel}: ${profile.email}`}>{profile.email}<Arrow /></a></div><div class="contact-side"><p>{c.location}</p><nav aria-label={locale === 'en' ? 'Jay’s profiles' : 'Jay 的个人主页'}>{profile.social.map((item) => <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">{item.label}<Arrow /></a>)}</nav><p>{c.contactBusiness}</p><a class="text-link" href="https://bestai.co.nz/" target="_blank" rel="noopener noreferrer">BestAI Labs<Arrow /></a></div></div>
  </section>
</main>
<Footer locale={locale} />
