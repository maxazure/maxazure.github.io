---
import { ui } from '../data/content';
import { copy, profile, type Locale } from '../data/profile';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Arrow from './Arrow.astro';
import FeaturedWork from './FeaturedWork.astro';
import TransformerField from './TransformerField.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui(locale);
const c = copy[locale];
---
<Header locale={locale} />
<main id="main">
  <div class="hero-backdrop">
  <section class="hero shell" id="home" aria-labelledby="hero-title">
    <div class="hero-main">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{c.location}</p>
      <h1 id="hero-title"><span class="hero-name">{c.heroName}<span class="name-stop">.</span></span><span class="hero-role">{c.role.split("\n").map(part => <span>{part}</span>)}</span></h1>
      <p class="hero-specialism">{c.heroSpecialism}</p>
      <p class="hero-intro">{c.heroIntro}</p>
      <p class="hero-description">{c.heroBody}</p>
      <div class="hero-actions"><a class="button button-primary" href="#portfolio">{c.viewWork}<Arrow direction="right" /></a><a class="text-link" href="/cv/Jie-Liu-CV.pdf">{c.cvLabel}<Arrow /></a><a class="text-link" href="https://www.linkedin.com/in/jayliuinvers/" target="_blank" rel="noopener noreferrer">LinkedIn<Arrow /></a></div>
    </div>
    <aside class="hero-panel" aria-label={t("Engineering focus")}>
      <p class="panel-head"><span>{t("Engineering focus")}</span><span>03</span></p>
      <TransformerField />
      <ol class="domain-list">{c.heroDomains.map((domain, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{domain}</li>)}</ol>
    </aside>
  </section>
  </div>
  <div class="stack-strip"><div class="shell stack-inner"><span>ERP / CRM</span><span>.NET</span><span>React</span><span>Python</span><span>{t("AI Agents")}</span><span>{t("From architecture to delivery")}<span class="small-cross" aria-hidden="true">+</span></span></div></div>

  <section class="about-section shell section-space" id="about" aria-labelledby="about-title">
    <div class="section-intro"><p class="eyebrow">{c.aboutLabel}</p><h2 id="about-title" class="display-heading">{c.aboutHeading.split('\n').map((line) => <span>{line}</span>)}</h2><figure class="about-portrait"><img src="/images/jay-liu.jpg" alt={t("Jay Liu")} width="219" height="256" loading="lazy" decoding="async" /><figcaption>Jay Liu<span>{c.portraitName}</span></figcaption></figure></div>
    <div class="about-copy"><p class="lead">{c.aboutLead}</p><p>{c.aboutBody}</p><p>{c.aboutBody2}</p></div>
  </section>

  <FeaturedWork locale={locale} />

  <section class="experience-section section-space" id="resume" aria-labelledby="experience-title"><div class="shell experience-layout">
    <div class="experience-intro"><p class="eyebrow">{c.experienceLabel}</p><h2 id="experience-title" class="display-heading">{c.experienceHeading}</h2><p>{c.experienceIntro}</p><div class="education"><p class="eyebrow">{c.educationLabel}</p><h3>{c.education}</h3><p>{c.educationSchool}</p><p>{c.educationNote}</p></div></div>
    <ol class="experience-list">{c.experience.map((item, i) => <li class:list={['experience-row', i === 0 && 'current-role']}><p class="experience-date">{item.date}</p><div><h3>{item.role}</h3><p class="experience-company">{item.company}</p><p class="experience-place">{item.place}</p><p class="experience-description">{item.description}</p>{item.responsibilities && <ul class="delivery-responsibilities">{item.responsibilities.map(responsibility => <li>{responsibility}</li>)}</ul>}{'note' in item && <p class="experience-note">{item.note}</p>}</div></li>)}</ol>
  </div></section>

  <section class="skills-section shell section-space" id="skills" aria-labelledby="skills-title">
    <div class="section-header"><div><p class="eyebrow">{c.skillLabel}</p><h2 id="skills-title" class="display-heading">{c.skillHeading.split('\n').map((line) => <span>{line}</span>)}</h2></div></div>
    <p class="section-description">{c.skillIntro}</p>
    <div class="skills-grid">{c.skills.map((skill) => <article class="skill-group"><h3>{skill.name}</h3><p>{skill.summary}</p><ul>{skill.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
  </section>

  <section class="open-source-section shell" aria-labelledby="open-source-title">
    <div><p class="eyebrow">{t("Open-source work")}</p><h2 id="open-source-title">{t("Follow the implementation.")}</h2><p>{t("Source, workflow instructions and examples you can inspect.")}</p></div>
    <ul>
      <li><a class="text-link" href="https://github.com/maxazure/video-editing-skill" target="_blank" rel="noopener noreferrer">Video Editing Skill<Arrow /></a><p>{t("Transcript-led editing, FFmpeg rendering and artifact checks.")}</p></li>
      <li><a class="text-link" href="https://github.com/codexview/codexview" target="_blank" rel="noopener noreferrer">CodexView<Arrow /></a><p>{t("Transcript adapters, a React viewer and a Markdown CLI.")}</p></li>
      <li><a class="text-link" href="https://github.com/maxazure/new-zealand-accounting-assistant" target="_blank" rel="noopener noreferrer">NZ Accounting Assistant<Arrow /></a><p>{t("Traceable bookkeeping workflows and exports for review.")}</p></li>
    </ul>
  </section>

  <section class="contact-section shell section-space" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">{c.contactLabel}</p><div class="contact-layout"><div><h2 id="contact-title">{c.contactHeading.split('\n').map(line => <span>{line}</span>)}</h2><p>{c.contactBody}</p><a class="contact-email" href={`mailto:${profile.email}`} aria-label={`${c.emailLabel}: ${profile.email}`}>{profile.email}<Arrow /></a></div><div class="contact-side"><a class="text-link" href="/cv/Jie-Liu-CV.pdf">{c.cvLabel}<Arrow /></a><p>{c.location}</p><nav aria-label={t("Jay’s profiles")}>{profile.social.map((item) => <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">{item.label}<Arrow /></a>)}</nav></div></div>
  </section>
</main>
<Footer locale={locale} />
